# Copy to .env and fill in. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Gemini (independent AI learning + teacher AI tools). Without a key, students get clearly-labelled
# placeholder quizzes and teacher AI features report "unavailable".
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_MS=150000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=1

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_RECORDING_ENABLED=True
# Keep False until the consent-confirmed Egress and private playback test passes.
LIVEKIT_RECORDING_VERIFIED=True
LIVEKIT_RECORDING_S3_BUCKET=cerebrox-recordings
LIVEKIT_RECORDING_S3_REGION=auto
LIVEKIT_RECORDING_S3_ACCESS_KEY=your-r2-access-key-id
LIVEKIT_RECORDING_S3_SECRET=your-r2-secret-access-key
LIVEKIT_RECORDING_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Configure this URL as a webhook in LiveKit Cloud so attendance and Egress states update:
# https://your-domain.example/market/livekit/webhook/
# Keep public access blocked on the S3 bucket; playback uses short-lived signed links.

# Public base URL used in shareable quiz links (leave empty to use the request host)
SITE_URL=

# SMTP for emailing quiz links. Leave EMAIL_HOST empty to print emails to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CerebroX AI <no-reply@example.com>

# Teacher-supervised quizzes / uploads
QUIZ_QR_TTL_SECONDS=120
QUIZ_SUBMIT_GRACE_SECONDS=10
MATERIAL_MAX_MB=100
