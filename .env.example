# Copy to .env and fill in. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Gemini (independent AI learning + teacher AI tools). Without a key, students get clearly-labelled
# placeholder quizzes and teacher AI features report "unavailable".
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_MS=150000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=1

# Public base URL used in shareable quiz links (leave empty to use the request host)
SITE_URL=

# SMTP for emailing quiz links. Leave EMAIL_HOST empty to print emails to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CerebroX AI <no-reply@example.com>

# Teacher-supervised quizzes / uploads
QUIZ_QR_TTL_SECONDS=120
QUIZ_SUBMIT_GRACE_SECONDS=10
MATERIAL_MAX_MB=100
